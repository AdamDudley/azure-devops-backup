# Copy to configs/devops.env (gitignored).

# Required — PAT needs Code: Read and Wiki: Read
DEVOPS_PAT=xxxxxxxxxxxxxxxxxxxxxxxxx
DEVOPS_ORGANIZATION_URL=https://dev.azure.com/myOrganization

# Optional: upload the zips to SharePoint after each run (1 = on)
COPY_ARCHIVES_TO_SHAREPOINT_ENABLED=0
# SHAREPOINT_URL=https://myCompany.sharepoint.com/sites/backups
# SHAREPOINT_DIR=Documents/DevOps
# SHAREPOINT_CLIENT_ID=00000000-0000-0000-0000-000000000000
# SHAREPOINT_CLIENT_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxx

# Optional: where to keep mirrors / write zips (default ./tmp/clone and ./tmp/archive)
# PATH_CLONE=/mnt/backup/clone
# PATH_ARCHIVE=/mnt/backup/archive
