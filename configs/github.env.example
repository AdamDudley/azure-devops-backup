# Copy to configs/github.env (gitignored). Every value is optional.
# GITHUB_TOKEN=ghp_xxx            # defaults to `gh auth token`
# GITHUB_OWNER=AdamDudley         # defaults to the token's user
# REPO_FILTER=ppg,ttt2            # comma-separated repo names; empty = all
# INCLUDE_FORKS=0                 # 1 to also back up repos you forked
# FORCE_ARCHIVE=0                 # 1 to write a zip for every repo even if unchanged
# PATH_CLONE=/path/to/clone       # git mirrors (default ./tmp/clone)
# PATH_ARCHIVE=/path/to/archive   # zip output (default ./tmp/archive)
