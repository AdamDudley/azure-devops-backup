{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Backup GitHub repos (local)",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/app/main.py",
            "console": "integratedTerminal",
            "envFile": "${workspaceFolder}/configs/github.env",
            "env": {
                "PYTHONPATH": "${workspaceFolder}",
                "SOURCE": "github",
                "PATH_CLONE": "${workspaceFolder}/tmp/clone",
                "PATH_ARCHIVE": "${workspaceFolder}/tmp/archive"
            }
        },
        {
            "name": "Python Debugger: Remote Attach (container)",
            "type": "debugpy",
            "request": "attach",
            "connect": {
                "host": "localhost",
                "port": 5678
            },
            "pathMappings": [
                {
                    "localRoot": "${workspaceFolder}/app",
                    "remoteRoot": "/usr/src/app"
                }
            ]
        }
    ]
}
